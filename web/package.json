{
  "name": "portal-bi-logistica-web",
  "private": true,
  "scripts": {
    "format": "prettier --write \"../api/**/*.js\" \"**/*.{js,css,json,html,md}\" \"../README.md\" \"../package.json\" --config .prettierrc.json --ignore-path .prettierignore",
    "format:check": "prettier --check \"../api/**/*.js\" \"**/*.{js,css,json,html,md}\" \"../README.md\" \"../package.json\" --config .prettierrc.json --ignore-path .prettierignore"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
